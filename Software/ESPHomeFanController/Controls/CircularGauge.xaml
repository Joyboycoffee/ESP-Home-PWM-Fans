<UserControl x:Class="ESPHomeFanController.Controls.CircularGauge"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="180" d:DesignWidth="180"
             Background="Transparent">
    <Grid x:Name="LayoutRoot">
        <Canvas x:Name="DrawingCanvas" SizeChanged="DrawingCanvas_SizeChanged" />
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,5,0,0">
            <TextBlock x:Name="TxtTitle" 
                       Text="CPU TEMP" 
                       FontSize="11" 
                       FontWeight="SemiBold" 
                       Foreground="#94a3b8" 
                       HorizontalAlignment="Center"
                       Margin="0,0,0,2"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <TextBlock x:Name="TxtValue" 
                           Text="0" 
                           FontSize="28" 
                           FontWeight="Bold" 
                           Foreground="#f8fafc" 
                           HorizontalAlignment="Center"/>
                <TextBlock x:Name="TxtUnit" 
                           Text="°C" 
                           FontSize="14" 
                           FontWeight="SemiBold" 
                           Foreground="#94a3b8" 
                           VerticalAlignment="Top" 
                           Margin="2,2,0,0"/>
            </StackPanel>
            <TextBlock x:Name="TxtSubtext" 
                       Text="-- dBm" 
                       FontSize="10" 
                       FontWeight="Normal" 
                       Foreground="#64748b" 
                       HorizontalAlignment="Center"
                       Visibility="Collapsed"/>
        </StackPanel>
    </Grid>
</UserControl>
